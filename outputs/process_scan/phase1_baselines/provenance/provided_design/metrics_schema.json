      "type": "object",
      "properties": {
        "git_sha": {
          "type": "string"
        },
        "scene_manifest_hash": {
          "type": "string"
        },
        "protocol_hash": {
          "type": "string"
        },
        "robot_model_hash": {
          "type": "string"
        },
        "tool_model_hash": {
          "type": "string"
        },
        "controller_hash": {
          "type": "string"
        },
        "software_versions": {
          "type": "object"
        },
        "compute_resource": {
          "type": "object"
        },
        "planned_path_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_state_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "scan_samples_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "optimizer_trace_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "video_file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "git_sha",
        "scene_manifest_hash",
        "protocol_hash",
        "robot_model_hash",
        "tool_model_hash",
        "controller_hash",
        "software_versions",
        "compute_resource",
        "planned_path_file",
        "actual_state_file",
        "scan_samples_file",
        "optimizer_trace_file",
        "video_file"
      ],
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "required": [
        "initialization_method",
        "shared_seed_id",
        "geometry_adapter_version",
        "old_source_hashes",
        "nearest_projection_claim",
        "physical_velocity_enforced_in_geometry"
      ],
      "properties": {
        "initialization_method": {
          "type": "string"
        },
        "shared_seed_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_adapter_version": {
          "type": "string"
        },
        "old_source_hashes": {
          "type": "object"
        },
        "nearest_projection_claim": {
          "const": false
        },
        "physical_velocity_enforced_in_geometry": {
          "const": false
        },
        "pose_seed_checks": {
          "type": [
            "object",
            "null"
          ]
        },
        "process_node_checks": {
          "type": [
            "object",
            "null"
          ]
        },
        "process_dense_checks": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "identity",
    "status",
    "planning",
    "execution",
    "quality",
    "motion",
    "mechanism",
    "provenance",
    "lineage"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "quality_completed": {
                "const": true
              }
            },
            "required": [
              "quality_completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "properties": {
              "execution_completed": {
                "const": true
              },
              "planner_feasible": {
                "const": true
              }
            }
          },
          "quality": {
            "properties": {
              "valid_coverage_fraction": {
                "type": "number",
                "minimum": 0.99
              },
              "maximum_hole_diameter_m": {
                "type": "number",
                "maximum": 0.002
              }
            }
          },
          "execution": {
            "properties": {
              "sim_time_to_completion_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "execution_completed": {
                "const": false
              }
            },
            "required": [
              "execution_completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "sim_time_to_completion_s": {
                "type": "null"
              },
              "wall_time_to_completion_s": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
